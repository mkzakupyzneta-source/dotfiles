{{- /* Wlacza albo wylacza usluge uzytkownika `klapa-straznik.service` — sprawa [279], 2026-08-30.
       Decyduje DANA: pole `klapa_zamkniecie` w bloku TEJ maszyny w lustra/maszyny.toml.
       Wartosc jest wpisana ponizej w komentarz, wiec chezmoi uruchomi ten skrypt ponownie
       takze wtedy, gdy zmieni sie samo USTAWIENIE (nie tylko pliki uslugi).
       Podglad wyniku:  chezmoi execute-template < run_onchange_after_wlacz-klapa-straznik.sh.tmpl */ -}}
{{- $host := lower .chezmoi.hostname -}}
{{- $klapa := "usyp" -}}
{{- if stat (joinPath .chezmoi.sourceDir "lustra" "maszyny.toml") -}}
{{-   $flota := include "lustra/maszyny.toml" | fromToml -}}
{{-   range $flota.maszyna -}}
{{-     if and (hasKey . "nazwa_hosta") (hasKey . "klapa_zamkniecie") -}}
{{-       if and .nazwa_hosta (eq (lower .nazwa_hosta) $host) -}}
{{-         $klapa = .klapa_zamkniecie -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
#!/bin/sh
# Usluga uzytkownika `klapa-straznik.service` — wlaczana TYLKO na maszynie, ktora ma
# w danych `klapa_zamkniecie = "ekran-gasnie"`. Na kazdej innej jest wylaczana.
# Ten plik jest generowany przez chezmoi z szablonu — nie edytuj go na maszynie.
# odcisk uslugi:  {{ include "private_dot_config/systemd/user/klapa-straznik.service" | sha256sum }}
# odcisk skryptu: {{ include "bin/executable_klapa-straznik.sh" | sha256sum }}
# klapa tej maszyny ({{ .chezmoi.hostname }}): {{ $klapa }}
set -u
KLAPA="{{ $klapa }}"

if ! systemctl --user is-system-running >/dev/null 2>&1 && ! systemctl --user status >/dev/null 2>&1; then
    echo "[klapa-straznik] brak menedzera systemd usera w tej sesji — usluge ustawi nastepny apply z sesji graficznej"
    exit 0
fi

systemctl --user daemon-reload

if [ "$KLAPA" = "ekran-gasnie" ]; then
    systemctl --user enable klapa-straznik.service
    systemctl --user restart klapa-straznik.service || true
    echo "[klapa-straznik] wlaczona: $(systemctl --user is-enabled klapa-straznik.service 2>&1) / $(systemctl --user is-active klapa-straznik.service 2>&1)"
    echo "[klapa-straznik] UWAGA: bez drop-inu logind (lustra/zasilanie-stacja.sh --wykonaj) system uspi laptop"
    echo "[klapa-straznik] od razu po zamknieciu klapy i straznik nie zdazy nic zrobic."
else
    systemctl --user disable --now klapa-straznik.service >/dev/null 2>&1
    echo "[klapa-straznik] wylaczona — ta maszyna ma klapa_zamkniecie = $KLAPA"
fi
