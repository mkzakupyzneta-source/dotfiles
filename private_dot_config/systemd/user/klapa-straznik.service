[Unit]
Description=Straznik klapy: ekran gasnie od razu, uspienie po zwloce (sprawa [279])
Documentation=file:%h/bin/klapa-straznik.sh
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:1
ExecStart=%h/bin/klapa-straznik.sh
# Wyjscie 0 = "ta maszyna nie ma klapa_zamkniecie = ekran-gasnie" (skrypt sam czyta dane
# z lustra/maszyny.toml i konczy). Restart tylko po bledzie, zeby taka maszyna nie kreciła
# usługi w kółko.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
